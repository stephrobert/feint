      "replace": "\tif len(req.LoadBalancerPorts) == 0 && false {",
      "test": "TestListenerOperationsRequireTheirArguments"
    },
    {
      "label": "a refused listener batch is reported beside a nil return, so the store writes back and announces an update nothing made",
      "file": "internal/providers/outscale/listeners.go",
      "find": "\t\t\trefusal = listenerRefusal(why)\n\t\t\treturn refusal",
      "replace": "\t\t\trefusal = listenerRefusal(why)\n\t\t\treturn nil",
      "test": "TestARefusedListenerBatchPublishesNoEvent"
    }
  ]
}
