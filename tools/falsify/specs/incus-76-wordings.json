      "replace": "strings.Contains(strings.ToLower(err.Error()), \"instance is busy!\")",
      "test": "TestEveryMatchedWordingOfIncus76IsRecognised"
    },
    {
      "label": "isTransientConflict goes deaf to the 7.6 ETag refusal",
      "file": "internal/core/machine/incus.go",
      "find": "\t\tstrings.Contains(said, \"etag doesn't match\") ||",
      "replace": "\t\tstrings.Contains(said, \"etag doesn't match!\") ||",
      "test": "TestEveryMatchedWordingOfIncus76IsRecognised"
    },
    {
      "label": "isTransientConflict goes deaf to the OVSDB port-group collision as 7.6 relays it",
      "file": "internal/core/machine/incus.go",
      "find": "\t\tstrings.Contains(said, \"transaction causes multiple rows\")",
      "replace": "\t\tstrings.Contains(said, \"transaction causes multiple rows!\")",
      "test": "TestEveryMatchedWordingOfIncus76IsRecognised"
    },
    {
      "label": "isTransientConflict widens to any daemon error, so a refusal no retry changes is retried",
      "file": "internal/core/machine/incus.go",
      "find": "\t\tstrings.Contains(said, \"transaction causes multiple rows\")",
      "replace": "\t\tstrings.Contains(said, \"transaction causes multiple rows\") ||\n\t\tstrings.Contains(said, \"error:\")",
      "test": "TestTheIncus76WordingsThatMeanSomethingElseAreNotRetried"
    },
    {
      "label": "isAlreadyExists goes deaf to the 7.6 wording of a duplicate create",
      "file": "internal/core/machine/incus_firewall.go",
