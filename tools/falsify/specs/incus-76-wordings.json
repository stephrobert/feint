{
  "package": "./internal/core/machine/",
  "mutations": [
    {
      "label": "isNotFound goes deaf to the 7.6 wording of a missing instance",
      "file": "internal/core/machine/cli.go",
      "find": "\t\"instance not found\",\n",
      "replace": "\t\"instance not found!\",\n",
      "test": "TestEveryMatchedWordingOfIncus76IsRecognised"
    },
    {
      "label": "isNotFound goes deaf to the 7.6 wording of a missing network, the #455 peer refusal included",
      "file": "internal/core/machine/cli.go",
      "find": "\t\"network not found\",\n",
      "replace": "\t\"network not found!\",\n",
      "test": "TestEveryMatchedWordingOfIncus76IsRecognised"
    },
    {
      "label": "isNotFound goes deaf to the 7.6 wording of a missing rule set",
      "file": "internal/core/machine/cli.go",
      "find": "\t\"network acl not found\",\n",
      "replace": "\t\"network acl not found!\",\n",
      "test": "TestEveryMatchedWordingOfIncus76IsRecognised"
    },
    {
      "label": "isNotFound goes deaf to the 7.6 wording of a missing forward",
